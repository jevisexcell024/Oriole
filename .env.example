# ─── Orcalis Assess — environment ───────────────────────────────────────────
# Copy to `.env` for local overrides, or set these in your hosting provider.
# In production the server REFUSES TO START unless JWT_SECRET, DATABASE_URL and
# DATA_ENCRYPTION_KEY are set (see server/env.ts).

NODE_ENV=development
API_PORT=8787

# Session signing key. Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET=

# Managed Postgres connection string. When unset, the server falls back to an
# embedded PGlite file under server/.pgdata (local dev / tests only).
# DATABASE_URL=postgres://user:pass@host:5432/orcalis
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true

# AES-256-GCM key for encrypting proctoring media / PII at rest (base64, 32 bytes).
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# DATA_ENCRYPTION_KEY=

# Purge proctoring webcam frames older than N days (0 = keep indefinitely).
PROCTOR_RETENTION_DAYS=0

# Logging / limits
LOG_LEVEL=debug
API_RATE_LIMIT=600

# Email (optional). MAIL_TRANSPORT=smtp enables real delivery; otherwise a
# mock/preview transport is used and messages are logged.
# MAIL_TRANSPORT=smtp
# MAIL_FROM="Orcalis Assess <no-reply@orcalis.dev>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# SMS / WhatsApp reminders (optional). SMS_PROVIDER=twilio enables real delivery.
# SMS_PROVIDER=twilio
# SMS_CHANNEL=sms            # or "whatsapp"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+14155551234
# TWILIO_WHATSAPP_FROM=

# Microsoft (Entra / Microsoft 365) SSO (optional, student portal only). When all three
# are set, a "Continue with Microsoft" button appears on /portal. It only signs in student
# accounts that already exist (matched by email on first use, then locked to that Microsoft
# identity); it never creates accounts. Register this redirect URI in your Entra app:
#   https://YOUR-DOMAIN/api/auth/sso/microsoft/callback
# MS_CLIENT_ID=
# MS_TENANT=                 # your directory (tenant) ID, a GUID. "organizations"/"common" are refused
# The app proves itself to Microsoft with EITHER a client secret...
# MS_CLIENT_SECRET=
# ...OR a certificate (for schools that don't allow secrets): upload the public .cer to the Entra
# app, keep the matching PRIVATE key (PEM) on the server, and give its path + the cert's thumbprint.
# MS_CLIENT_CERT_KEY_PATH=/home/USER/secrets/oriole-sso.key
# MS_CLIENT_CERT_THUMBPRINT=  # shown in Entra next to the uploaded certificate (SHA-1 or SHA-256 hex)
# MS_REDIRECT_URI=           # optional; defaults to APP_URL + the path above

# AI features (optional) — OpenAI-compatible (Groq/Gemini/OpenRouter) or Anthropic.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# ANTHROPIC_API_KEY=
# ORCALIS_AI_MODEL=claude-opus-4-8

# Malware scanning for file-upload exam answers (optional, Cloudmersive Virus
# Scan API). Without this set, uploads still go through the MIME allowlist +
# content-sniff check, just without a full AV scan. Sign up for a free key at
# https://cloudmersive.com (free tier: 800 scans/month).
# CLOUDMERSIVE_API_KEY=
